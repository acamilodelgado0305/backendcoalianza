generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cierres {
  id             Int       @id @default(autoincrement())
  user_id        Int
  fecha_cierre   DateTime? @default(now()) @db.Timestamp(6)
  total_ingresos Decimal?  @default(0) @db.Decimal(12, 2)
  total_pedidos  Int?      @default(0)
  observaciones  String?
  business_id    Int?
  pedidos        pedidos[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_pedidos {
  id              Int        @id @default(autoincrement())
  pedido_id       Int
  inventario_id   Int
  cantidad        Int
  precio_unitario Decimal    @db.Decimal(12, 2)
  subtotal        Decimal?   @default(dbgenerated("((cantidad)::numeric * precio_unitario)")) @db.Decimal(12, 2)
  inventario      inventario @relation(fields: [inventario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_inventario")
  pedidos         pedidos    @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_detalle_pedido")

  @@index([pedido_id], map: "idx_detalle_pedido")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model documentos_venta {
  id                     Int                @id @default(autoincrement())
  tipo                   String             @db.VarChar(20)
  numero                 String?            @db.VarChar(50)
  business_id            Int
  usuario_id             Int?
  persona_id             Int?
  cliente_nombre         String?            @db.VarChar(200)
  cliente_identificacion String?            @db.VarChar(100)
  cliente_email          String?            @db.VarChar(200)
  cliente_telefono       String?            @db.VarChar(50)
  cliente_direccion      String?
  items                  Json               @default("[]")
  subtotal               Decimal?           @default(0) @db.Decimal(12, 2)
  descuento_global       Decimal?           @default(0) @db.Decimal(12, 2)
  impuesto_total         Decimal?           @default(0) @db.Decimal(12, 2)
  total                  Decimal?           @default(0) @db.Decimal(12, 2)
  notas                  String?
  condiciones            String?
  estado                 String?            @default("BORRADOR") @db.VarChar(30)
  fecha_emision          DateTime?          @default(dbgenerated("CURRENT_DATE")) @db.Date
  fecha_vencimiento      DateTime?          @db.Date
  fecha_pago             DateTime?          @db.Date
  total_abonado          Decimal?           @default(0) @db.Decimal(12, 2)
  abonos                 Json               @default("[]")
  origen_cotizacion_id   Int?
  created_at             DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?          @default(now()) @db.Timestamptz(6)
  documentos_venta       documentos_venta?  @relation("documentos_ventaTodocumentos_venta", fields: [origen_cotizacion_id], references: [id], onUpdate: NoAction)
  other_documentos_venta documentos_venta[] @relation("documentos_ventaTodocumentos_venta")

  @@index([business_id], map: "idx_dv_business_id")
  @@index([estado], map: "idx_dv_estado")
  @@index([fecha_emision(sort: Desc)], map: "idx_dv_fecha")
  @@index([tipo], map: "idx_dv_tipo")
}

model cuentas_por_pagar {
  id                Int       @id @default(autoincrement())
  titulo            String    @db.VarChar(200)
  business_id       Int
  usuario_id        Int?
  persona_id        Int?
  proveedor_nombre  String?   @db.VarChar(200)
  total             Decimal?  @default(0) @db.Decimal(12, 2)
  total_abonado     Decimal?  @default(0) @db.Decimal(12, 2)
  abonos            Json      @default("[]")
  cargos            Json      @default("[]")
  estado            String?   @default("PENDIENTE") @db.VarChar(30)
  notas             String?
  fecha_emision     DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  fecha_vencimiento DateTime? @db.Date
  fecha_pago        DateTime? @db.Date
  num_cuotas        Int?      @default(1)
  valor_cuota       Decimal?  @db.Decimal(12, 2)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@index([business_id], map: "idx_cpp_business_id")
  @@index([estado], map: "idx_cpp_estado")
  @@index([fecha_vencimiento], map: "idx_cpp_vencimiento")
}

// Préstamos que el negocio hace a sus contactos. Misma forma que
// cuentas_por_pagar; ver cuentas_por_cobrar_migration.sql
model cuentas_por_cobrar {
  id                Int       @id @default(autoincrement())
  titulo            String    @db.VarChar(200)
  business_id       Int
  usuario_id        Int?
  persona_id        Int?
  deudor_nombre     String?   @db.VarChar(200)
  egreso_ref        String?   // egresos._id del préstamo inicial
  total             Decimal?  @default(0) @db.Decimal(12, 2)
  total_abonado     Decimal?  @default(0) @db.Decimal(12, 2)
  abonos            Json      @default("[]")
  cargos            Json      @default("[]")
  estado            String?   @default("PENDIENTE") @db.VarChar(30)
  notas             String?
  fecha_emision     DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  fecha_vencimiento DateTime? @db.Date
  fecha_pago        DateTime? @db.Date
  num_cuotas        Int?      @default(1)
  valor_cuota       Decimal?  @db.Decimal(12, 2)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@index([business_id], map: "idx_cxc_business_id")
  @@index([estado], map: "idx_cxc_estado")
  @@index([fecha_vencimiento], map: "idx_cxc_vencimiento")
}

model egresos {
  id          BigInt    @id @default(autoincrement())
  legacyId    String?   @map("_id")
  fecha       DateTime? @db.Timestamptz(6)
  valor       Decimal?  @db.Decimal(12, 2)
  cuenta      String?
  descripcion String?
  createdAt   DateTime? @db.Timestamptz(6)
  updatedAt   DateTime? @db.Timestamptz(6)
  v           Int?      @map("__v")
  usuario     Int?
  business_id Int?
  categoria_id Int?
  categoria    egreso_categorias? @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  comprobante_url String? // documento soporte (PDF o imagen) en GCS

  @@index([legacyId], map: "idx_egresos_id_text")
}

// Categorías con que cada negocio clasifica sus gastos. El índice único
// (business_id, LOWER(nombre)) vive solo en egreso_categorias_migration.sql:
// Prisma no puede expresar índices con LOWER().
model egreso_categorias {
  id          Int       @id @default(autoincrement())
  business_id Int
  nombre      String    @db.VarChar(80)
  color       String?   @db.VarChar(7) // #rrggbb; en la interfaz son «etiquetas» de color
  tipo        String    @default("gasto") @db.VarChar(10) // 'gasto' | 'ingreso': dos listas separadas
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  egresos     egresos[]
  ingresos    ingresos[]
}

model ingreso_items {
  id              Int         @id @default(autoincrement())
  ingreso_id      String
  inventario_id   Int?
  cantidad        Decimal     @default(1) @db.Decimal
  precio_unitario Decimal?    @db.Decimal
  created_at      DateTime?   @default(now()) @db.Timestamp(6)
  descripcion     String?
  inventario      inventario? @relation(fields: [inventario_id], references: [id], onUpdate: NoAction)

  @@index([ingreso_id], map: "idx_ingreso_items_ingreso")
  @@index([inventario_id], map: "idx_ingreso_items_inventario")
}

model ingresos {
  id                BigInt    @id @default(autoincrement())
  legacyId          String?   @map("_id")
  nombre            String?
  apellido          String?
  numeroDeDocumento String?
  fechaVencimiento  DateTime? @db.Timestamptz(6)
  createdAt         DateTime? @db.Timestamptz(6)
  updatedAt         DateTime? @db.Timestamptz(6)
  v                 String?   @map("__v")
  producto          String?
  valor             Decimal?  @db.Decimal(12, 2)
  cuenta            String?
  customer_email    String?
  payment_status    String?
  payment_reference String?
  usuario           Int?
  comprobante_url   String?
  tipoDocumento     String?   @default("C.C") @db.VarChar(10)
  business_id       Int?
  persona_id        Int?
  pedido_id         Int?
  descripcion       String?
  categoria_id      Int? // etiqueta de color del ingreso (egreso_categorias con tipo 'ingreso')
  pedidos           pedidos?  @relation(fields: [pedido_id], references: [id], onUpdate: NoAction)
  personas          personas? @relation(fields: [persona_id], references: [id], onUpdate: NoAction)
  categoria         egreso_categorias? @relation(fields: [categoria_id], references: [id], onDelete: SetNull)

  @@index([legacyId], map: "idx_ingresos_id_text")
  @@index([categoria_id], map: "idx_ingresos_categoria")
  @@index([numeroDeDocumento, payment_status], map: "idx_cedula_status")
  @@index([pedido_id], map: "idx_ingresos_pedido_id")
  @@index([persona_id], map: "idx_ingresos_persona_id")
}

model inventario {
  id                     Int               @id @default(autoincrement())
  nombre                 String            @db.VarChar(255)
  descripcion            String?
  monto                  Decimal?          @default(0) @db.Decimal
  user_id                Int?
  cantidad               Int?              @default(0)
  tipo_programa          String?           @db.VarChar(50)
  created_at             DateTime?         @default(now()) @db.Timestamp(6)
  updated_at             DateTime?         @default(now()) @db.Timestamp(6)
  imagen_url             String?
  costo_compra           Decimal?          @default(0) @db.Decimal
  unidades_por_caja      Int?              @default(1)
  codigo_barras          String?           @db.VarChar(50)
  business_id            Int?
  tipo_item              String?           @default("producto") @db.VarChar(20)
  sku                    String?           @db.VarChar(100)
  precio_compra_unitario Decimal?          @default(0) @db.Decimal(12, 2)
  stock_minimo           Int?              @default(0)
  categoria              String?           @db.VarChar(100)
  impuesto               Decimal?          @default(0) @db.Decimal(5, 2)
  send_mail              Boolean?          @default(false)
  plantilla_correo       String?           @db.VarChar(30)
  intensidad_horaria     String?           @db.VarChar(20)
  detalle_pedidos        detalle_pedidos[]
  ingreso_items          ingreso_items[]

  @@unique([nombre, user_id], map: "unique_nombre_user_id")
  @@index([codigo_barras], map: "idx_codigo_barras")
}

model pedidos {
  id              Int                 @id @default(autoincrement())
  persona_id      Int?
  cliente_nombre  String?             @db.VarChar(200)
  user_id         Int
  total           Decimal             @default(0) @db.Decimal(12, 2)
  estado          estado_pedido_enum? @default(PENDIENTE)
  observaciones   String?
  created_at      DateTime?           @default(now()) @db.Timestamp(6)
  updated_at      DateTime?           @default(now()) @db.Timestamp(6)
  cierre_id       Int?
  business_id     Int?
  detalle_pedidos detalle_pedidos[]
  ingresos        ingresos[]          @ignore
  cierres         cierres?            @relation(fields: [cierre_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedidos_cierre")
  personas        personas?           @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedidos_persona")

  @@index([estado], map: "idx_pedidos_estado")
  @@index([created_at], map: "idx_pedidos_fecha")
  @@index([persona_id], map: "idx_pedidos_persona")
}

model personas {
  id               Int                @id @default(autoincrement())
  tipo_documento   String             @db.VarChar(10)
  numero_documento String?            @db.VarChar(20)
  nombre           String             @db.VarChar(100)
  apellido         String?            @db.VarChar(100)
  direccion        String?            @db.VarChar(255)
  celular          String             @db.VarChar(20)
  email            String?            @db.VarChar(150)
  tipo             tipo_persona_enum? @default(CLIENTE)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  usuario          Int?
  business_id      Int?
  ingresos         ingresos[]
  pedidos          pedidos[]

  @@unique([tipo_documento, numero_documento, business_id], map: "uq_personas_identificacion")
  @@index([celular], map: "idx_personas_celular")
  @@index([numero_documento], map: "idx_personas_documento")
  @@index([nombre], map: "idx_personas_nombre")
}

model crm_leads {
  id               Int       @id @default(autoincrement())
  nombre           String    @db.VarChar(150)
  empresa          String?   @db.VarChar(150)
  tipo_documento   String?   @db.VarChar(10)
  numero_documento String?   @db.VarChar(30)
  email            String?   @db.VarChar(150)
  telefono         String?   @db.VarChar(30)
  origen           String?   @default("OTRO") @db.VarChar(30)
  estado           String?   @default("NUEVO") @db.VarChar(30)
  valor_estimado   Decimal?  @default(0) @db.Decimal(12, 2)
  notas            String?
  persona_id       Int?
  usuario          Int?
  business_id      Int?
  fbc              String?   @db.VarChar(255)
  fbp              String?   @db.VarChar(255)
  servicio         String?   @db.VarChar(100)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([business_id], map: "idx_crm_leads_business")
  @@index([estado], map: "idx_crm_leads_estado")
  @@index([servicio], map: "idx_crm_leads_servicio")
}

/// Pagos de Mercado Pago recibidos por el webhook (ver prisma/sql/mp_pagos.sql).
model mp_pagos {
  id                 Int       @id @default(autoincrement())
  payment_id         String    @unique @db.VarChar(40)
  external_reference String?   @db.VarChar(64)
  producto           String?   @db.VarChar(30)
  status             String?   @db.VarChar(30)
  status_detail      String?   @db.VarChar(80)
  monto              Decimal?  @db.Decimal(12, 2)
  moneda             String?   @db.VarChar(5)
  payer_email        String?   @db.VarChar(150)
  estado_proceso     String    @default("RECIBIDO") @db.VarChar(20)
  intentos           Int       @default(0)
  lead_id            Int?
  ingreso_id         BigInt?
  correo_enviado_a   String?   @db.VarChar(150)
  correo_enviado_at  DateTime? @db.Timestamp(6)
  error              String?
  raw                Json?
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @default(now()) @db.Timestamp(6)

  @@index([estado_proceso], map: "idx_mp_pagos_estado")
  @@index([external_reference], map: "idx_mp_pagos_reference")
}

/// Pagos Nequi que n8n confirma desde el correo de notificación (ver prisma/sql/nequi_pagos.sql).
model nequi_pagos {
  id                Int       @id @default(autoincrement())
  referencia        String    @unique @db.VarChar(64)
  documento         String    @db.VarChar(20)
  monto             Decimal   @db.Decimal(12, 2)
  fecha_pago        DateTime? @db.Timestamptz(6)
  estado_proceso    String    @default("RECIBIDO") @db.VarChar(20)
  intentos          Int       @default(0)
  lead_id           Int?
  inventario_id     Int?
  ingreso_id        BigInt?
  capi_estado       String?   @db.VarChar(20)
  correo_enviado_a  String?   @db.VarChar(150)
  correo_enviado_at DateTime? @db.Timestamp(6)
  error             String?
  raw               Json?
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @db.Timestamp(6)

  @@index([estado_proceso], map: "idx_nequi_pagos_estado")
  @@index([documento], map: "idx_nequi_pagos_documento")
}

enum estado_pedido_enum {
  PENDIENTE
  ENTREGADO
  ANULADO
}

enum person_type_enum {
  CLIENT
  SUPPLIER
  EMPLOYEE
  MIXED
}

enum tipo_persona_enum {
  CLIENTE
  PROVEEDOR
  EMPLEADO
  COLABORADOR
}

/// Punto de partida del saldo acumulado por negocio.
/// Ver: finanzas_config_migration.sql (raíz del repo)
model finanzas_config {
  id               Int       @id @default(autoincrement())
  business_id      Int       @unique
  saldo_inicial    Decimal   @default(0) @db.Decimal(14, 2)
  fecha_corte      DateTime? @db.Date
  notas            String?
  /// Claves de las tarjetas que el negocio decidió ocultar del panel
  tarjetas_ocultas Json      @default("[]")
  /// Movimientos abre siempre el formulario completo en vez del registro rápido
  registro_completo Boolean  @default(false)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@index([business_id], map: "idx_finanzas_config_business_id")
}

// ─── TAREAS (tablero tipo Trello) ─── ver prisma/sql/tareas.sql ─────────────

model tareas_tableros {
  id          Int               @id @default(autoincrement())
  /// Dueño: las tareas son del usuario, se ven desde cualquier negocio
  user_id     Int
  /// Negocio donde se creó (solo referencia)
  business_id Int?
  nombre      String            @db.VarChar(120)
  descripcion String?
  color       String            @default("#1d4ed8") @db.VarChar(7)
  icono       String?           @db.VarChar(16)
  posicion    Float             @default(0)
  favorito    Boolean           @default(false)
  archivado   Boolean           @default(false)
  created_by  Int?
  created_at  DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?         @default(now()) @db.Timestamptz(6)
  listas      tareas_listas[]
  etiquetas   tareas_etiquetas[]
  tarjetas    tareas_tarjetas[]

  @@index([business_id], map: "idx_tareas_tableros_business")
  @@index([user_id], map: "idx_tareas_tableros_user")
}

model tareas_listas {
  id         Int               @id @default(autoincrement())
  tablero_id Int
  nombre     String            @db.VarChar(120)
  posicion   Float             @default(0)
  /// Lista de cierre ("✅ Hecho"): lo que entra aquí queda completado
  es_final   Boolean           @default(false)
  created_at DateTime?         @default(now()) @db.Timestamptz(6)
  tablero    tareas_tableros   @relation(fields: [tablero_id], references: [id], onDelete: Cascade)
  tarjetas   tareas_tarjetas[]

  @@index([tablero_id], map: "idx_tareas_listas_tablero")
}

model tareas_etiquetas {
  id         Int                        @id @default(autoincrement())
  tablero_id Int
  nombre     String                     @default("") @db.VarChar(60)
  color      String                     @db.VarChar(7)
  posicion   Float                      @default(0)
  created_at DateTime?                  @default(now()) @db.Timestamptz(6)
  tablero    tareas_tableros            @relation(fields: [tablero_id], references: [id], onDelete: Cascade)
  tarjetas   tareas_tarjeta_etiquetas[]

  @@index([tablero_id], map: "idx_tareas_etiquetas_tablero")
}

model tareas_tarjetas {
  id               Int                        @id @default(autoincrement())
  tablero_id       Int
  lista_id         Int
  titulo           String                     @db.VarChar(500)
  descripcion      String?
  posicion         Float                      @default(0)
  fecha_inicio     DateTime?                  @db.Date
  /// Sin hora (vence_con_hora = false) se guarda a las 9:00 de Colombia de ese día
  vence_at         DateTime?                  @db.Timestamptz(6)
  vence_con_hora   Boolean                    @default(true)
  /// Minutos antes del vencimiento para avisar al celular (null = sin aviso)
  recordatorio_min Int?
  recordado_at     DateTime?                  @db.Timestamptz(6)
  /// Tarea que se repite: { frecuencia, cada, dias, hasta, lista_id }
  repeticion       Json?
  /// Ya se creó la siguiente de la serie
  repetida_at      DateTime?                  @db.Timestamptz(6)
  /// id de la primera tarjeta de la serie
  serie_id         Int?
  /// Orden manual dentro del día en el Resumen (misma escala que vence_at en ms; null = por hora)
  orden_dia        Float?
  completada       Boolean                    @default(false)
  completada_at    DateTime?                  @db.Timestamptz(6)
  archivada        Boolean                    @default(false)
  created_by       Int?
  created_by_name  String?                    @db.VarChar(120)
  created_at       DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?                  @default(now()) @db.Timestamptz(6)
  tablero          tareas_tableros            @relation(fields: [tablero_id], references: [id], onDelete: Cascade)
  lista            tareas_listas              @relation(fields: [lista_id], references: [id], onDelete: Cascade)
  etiquetas        tareas_tarjeta_etiquetas[]
  subtareas        tareas_subtareas[]
  comentarios      tareas_comentarios[]
  adjuntos         tareas_adjuntos[]

  @@index([tablero_id, lista_id], map: "idx_tareas_tarjetas_tablero")
}

model tareas_tarjeta_etiquetas {
  tarjeta_id  Int
  etiqueta_id Int
  tarjeta     tareas_tarjetas  @relation(fields: [tarjeta_id], references: [id], onDelete: Cascade)
  etiqueta    tareas_etiquetas @relation(fields: [etiqueta_id], references: [id], onDelete: Cascade)

  @@id([tarjeta_id, etiqueta_id])
  @@index([etiqueta_id], map: "idx_tareas_tarjeta_etiquetas_etiqueta")
}

model tareas_subtareas {
  id         Int             @id @default(autoincrement())
  tarjeta_id Int
  texto      String          @db.VarChar(500)
  hecha      Boolean         @default(false)
  posicion   Float           @default(0)
  created_at DateTime?       @default(now()) @db.Timestamptz(6)
  tarjeta    tareas_tarjetas @relation(fields: [tarjeta_id], references: [id], onDelete: Cascade)

  @@index([tarjeta_id], map: "idx_tareas_subtareas_tarjeta")
}

model tareas_comentarios {
  id         Int             @id @default(autoincrement())
  tarjeta_id Int
  user_id    Int?
  user_name  String?         @db.VarChar(120)
  texto      String
  created_at DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at DateTime?       @db.Timestamptz(6)
  tarjeta    tareas_tarjetas @relation(fields: [tarjeta_id], references: [id], onDelete: Cascade)

  @@index([tarjeta_id], map: "idx_tareas_comentarios_tarjeta")
}

model tareas_adjuntos {
  id         Int             @id @default(autoincrement())
  tarjeta_id Int
  /// 'archivo' (subido a GCS) | 'enlace'
  tipo       String          @default("archivo") @db.VarChar(10)
  nombre     String          @db.VarChar(255)
  url        String
  mime       String?         @db.VarChar(100)
  bytes      Int?
  created_by Int?
  created_at DateTime?       @default(now()) @db.Timestamptz(6)
  tarjeta    tareas_tarjetas @relation(fields: [tarjeta_id], references: [id], onDelete: Cascade)

  @@index([tarjeta_id], map: "idx_tareas_adjuntos_tarjeta")
}

/// Celulares/navegadores que aceptaron notificaciones (un endpoint por dispositivo)
model push_suscripciones {
  id              Int       @id @default(autoincrement())
  user_id         Int
  endpoint        String    @unique
  p256dh          String
  auth            String
  dispositivo     String?   @db.VarChar(200)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  ultimo_envio_at DateTime? @db.Timestamptz(6)

  @@index([user_id], map: "idx_push_suscripciones_user")
}

/// Qué avisos de Tareas quiere cada usuario
model tareas_avisos {
  user_id        Int       @id
  activo         Boolean   @default(true)
  resumen_diario Boolean   @default(true)
  /// Hora de Colombia (0-23) del resumen del día
  hora_resumen   Int       @default(7) @db.SmallInt
  ultimo_resumen DateTime? @db.Date
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
}
